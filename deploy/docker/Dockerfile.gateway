# syntax=docker/dockerfile:1
# SpeededERP.Gateway — YARP reverse proxy, the microservices extraction seam
# (architecture sections 04, 30, 32). Build context MUST be the repository root:
# docker build -f deploy/docker/Dockerfile.gateway .

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/Gateway/ src/Gateway/

RUN dotnet restore src/Gateway/SpeededERP.Gateway/SpeededERP.Gateway.csproj

RUN dotnet publish src/Gateway/SpeededERP.Gateway/SpeededERP.Gateway.csproj \
    --no-restore \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1000 speeded \
    && adduser --system --uid 1000 --ingroup speeded speeded

COPY --from=build /app/publish .

USER speeded
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "SpeededERP.Gateway.dll"]
