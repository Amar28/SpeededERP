# syntax=docker/dockerfile:1
# SpeededERP admin-portal — back-office SPA (architecture section 06).
# Build context MUST be the repository root: docker build -f deploy/docker/Dockerfile.admin-portal .

FROM node:22-alpine AS build
WORKDIR /src

RUN corepack enable && corepack prepare pnpm@11.10.0 --activate

COPY frontend/package.json frontend/pnpm-workspace.yaml frontend/pnpm-lock.yaml frontend/.npmrc ./frontend/
COPY frontend/packages/core/package.json ./frontend/packages/core/
COPY frontend/packages/ui-kit/package.json ./frontend/packages/ui-kit/
COPY frontend/packages/form-engine/package.json ./frontend/packages/form-engine/
COPY frontend/packages/api-client/package.json ./frontend/packages/api-client/
COPY frontend/apps/admin-portal/package.json ./frontend/apps/admin-portal/
COPY frontend/apps/tenant-portal/package.json ./frontend/apps/tenant-portal/

WORKDIR /src/frontend
RUN pnpm install --frozen-lockfile

WORKDIR /src
COPY frontend/ frontend/

WORKDIR /src/frontend
ARG VITE_API_BASE_URL=/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Sequential (--workspace-concurrency=1): parallel tsc -b processes across packages
# raced on filesystem visibility of each other's freshly-emitted dist/*.d.ts under
# Docker Desktop's Windows backend, intermittently failing with TS6305 even though the
# dependency graph and topological order were both correct.
RUN pnpm -r --workspace-concurrency=1 --filter=./packages/* --filter=./apps/* build

FROM nginx:1.29-alpine AS final
COPY deploy/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/frontend/apps/admin-portal/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://localhost:8080/health || exit 1
